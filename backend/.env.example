# ── Server ──
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_VERSION=v1
CORS_ORIGINS=http://localhost:8081

# ── Database ──
DATABASE_URL=postgresql://fitsocial:fitsocial@localhost:5432/fitsocial

# ── JWT ──
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── Cloudflare R2 ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fitsocial-media
R2_PUBLIC_URL=

# ── Email (Resend — password reset + signup OTP) ──
# Sign up at https://resend.com — verify your domain, create API key.
# See docs/OTP_EMAIL_SETUP.md for the full OTP checklist.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Mumbai Fitness Mafia <noreply@mumbaifitnessmafia.com>
# Mobile deep link opened from the reset email (must match app.json scheme)
PASSWORD_RESET_DEEP_LINK=fitsocial://reset-password

# ── Push Notifications ──
EXPO_ACCESS_TOKEN=

# ── Google Places (post location autocomplete; server-side only) ──
# Enable "Places API" in Google Cloud Console. Can be same project as mobile Maps keys.
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY

# ── OAuth (Google + Apple Sign-In token verification) ──
GOOGLE_OAUTH_IOS_CLIENT_ID=YOUR_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_ANDROID_CLIENT_ID=YOUR_GOOGLE_ANDROID_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
APPLE_CLIENT_ID=app.fitsocial.mobile
APPLE_BUNDLE_ID=app.fitsocial.mobile

# ── Monitoring ──
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ─── FUTURE INTEGRATIONS (not yet implemented) ─────────────────
# Uncomment when implementing:
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# TYPESENSE_HOST=localhost
# TYPESENSE_API_KEY=
