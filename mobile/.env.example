# ── API ──────────────────────────────────────────────────────
# Local dev: leave EXPO_PUBLIC_API_URL unset — Expo auto-detects your LAN IP from Metro.
# Pin only if auto-detect fails (must match your Mac's current IP, e.g. http://192.168.x.x:3000/api/v1).
# Staging/production builds: set to your deployed API (include /api/v1).
# EXPO_PUBLIC_API_URL=https://your-staging-api.example.com/api/v1

# ── Google Maps (native maps on iOS / Android) ───────────────
# Create separate keys in Google Cloud Console (Maps SDK for iOS + Android),
# or use one unrestricted dev key for both via EXPO_PUBLIC_GOOGLE_MAPS_API_KEY.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=YOUR_IOS_GOOGLE_MAPS_API_KEY
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=YOUR_ANDROID_GOOGLE_MAPS_API_KEY
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Google Places (post location autocomplete) ─────────────
# Server-side only — add GOOGLE_PLACES_API_KEY to backend/.env
# (Places API + billing enabled in Google Cloud Console).

# ── Google Sign-In (OAuth 2.0 — create iOS/Android/Web clients in Cloud Console) ──
# Expo Go uses the Web client via expoClientId / webClientId.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=YOUR_GOOGLE_ANDROID_CLIENT_ID.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=

# ── Auth welcome video (optional — defaults to royalty-free Pexels sports loop) ──
# EXPO_PUBLIC_AUTH_VIDEO_URI=https://your-cdn.com/sports-loop.mp4
