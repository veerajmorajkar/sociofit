# ── API ──────────────────────────────────────────────────────
# Include /api/v1. Dev: usually omitted — Expo auto-detects Metro host IP.
EXPO_PUBLIC_API_URL=https://your-staging-api.example.com/api/v1

# ── Google Maps (native maps on iOS / Android) ───────────────
# Create separate keys in Google Cloud Console (Maps SDK for iOS + Android),
# or use one unrestricted dev key for both via EXPO_PUBLIC_GOOGLE_MAPS_API_KEY.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=YOUR_IOS_GOOGLE_MAPS_API_KEY
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=YOUR_ANDROID_GOOGLE_MAPS_API_KEY
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Google Places (post location autocomplete) ─────────────
# Server-side only — add GOOGLE_PLACES_API_KEY to backend/.env
# (Places API + billing enabled in Google Cloud Console).
